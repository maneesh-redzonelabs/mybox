{
  "name": "mybox-portal",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server:install": "npm install --workspace server",
    "client:install": "npm install --workspace client",
    "server:dev": "npm run dev --workspace server",
    "client:dev": "npm run dev --workspace client",
    "server:test": "npm test --workspace server",
    "client:test": "npm test --workspace client",
    "migrate": "npm run migrate --workspace server"
  }
}
